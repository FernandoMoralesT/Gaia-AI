[node name="D0" parent="Margen/Columna/Desplazar/Lista" instance=ExtResource("4_des")]
layout_mode = 2
titulo = "Quiénes somos"
texto = "Somos Luis Fernando Morales Toledo, Sebastian Aguillon Peinado y Cristoff Salvador Garcia Mendoza, de Ingeniería en Sistemas en la FIMAZ-UAS, en Mazatlán. Esto empezó como proyecto de Estructura de Datos y terminó en la expo de IA."

[node name="D1" parent="Margen/Columna/Desplazar/Lista" instance=ExtResource("4_des")]
layout_mode = 2
titulo = "Cómo empezó"
texto = "Fernando quería mapas para su juego, A Stupid RPG. Hacerlos a mano era eterno, así que se nos ocurrió que una IA los inventara."

[node name="D2" parent="Margen/Columna/Desplazar/Lista" instance=ExtResource("4_des")]
layout_mode = 2
titulo = "Lo que nos costó"
texto = "Entrenamos todo en una laptop sin tarjeta gráfica compatible: 500 rondas de unos 5 segundos cada una. A partir de la ronda 190, más o menos, la red juez le empezó a ganar a la que dibuja, así que nos quedamos con la ronda 150, escogida a ojo comparando mapas."

[node name="D3" parent="Margen/Columna/Desplazar/Lista" instance=ExtResource("4_des")]
layout_mode = 2
titulo = "Cómo lo hicimos"
texto = "10 semanas, una meta por semana. Python y PyTorch para la IA, Godot para lo que estás viendo."
